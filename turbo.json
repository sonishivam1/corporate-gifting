{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".env"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "MONGODB_URI",
    "MONGODB_DB",
    "API_PORT",
    "API_PUBLIC_URL",
    "RECIPIENT_PUBLIC_URL",
    "CTP_*",
    "SMTP_URL",
    "DEV_AUTH"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:integration": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
