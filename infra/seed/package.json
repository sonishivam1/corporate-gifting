    "seed:demo": "tsx --env-file-if-exists=../../.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@commercetools/importapi-sdk": "7.1.2",
    "@gifting/ct": "workspace:*",
    "@gifting/domain": "workspace:*",
    "@gifting/logger": "workspace:*",
    "@gifting/db": "workspace:*",
    "@gifting/ledger": "workspace:*",
    "mongodb": "7.7.0"
  }
}
