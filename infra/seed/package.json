{
  "name": "@gifting/seed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
