{
  "name": "@gifting/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node ../../scripts/build-service.mjs src/server.ts dist/server.js",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "9.7.0",
    "@commercetools/ts-client": "5.1.1",
    "@gifting/channels": "workspace:*",
    "@gifting/ct": "workspace:*",
    "@gifting/db": "workspace:*",
    "@gifting/domain": "workspace:*",
    "@gifting/ledger": "workspace:*",
    "@gifting/logger": "workspace:*",
    "fastify": "5.12.7",
    "nodemailer": "10.1.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
