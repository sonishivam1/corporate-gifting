# Copy to .env at the repo root (gitignored). Every app, service and script reads it.
# Never commit real values. See docs/technical/configuration.md.

LOG_LEVEL=info

# MongoDB. Local Docker (pnpm db:up) is the default; Atlas:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=corporate-gifting-marketplace
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=gifting

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
RECIPIENT_PUBLIC_URL=http://localhost:3001

# Mailpit (pnpm db:up): UI at http://localhost:8025
SMTP_URL=smtp://localhost:1025

# Development-only sign-in. Never enable in a deployed environment.
DEV_AUTH=1

# commercetools (from the week-1 spikes on). Server-only secrets.
# pnpm ct:apply and pnpm seed refuse a project key without "sandbox" or "dev"
# in it, unless CTP_SETUP_PROJECT_KEY names that exact key.
# CTP_PROJECT_KEY=gifting-sandbox
# CTP_CLIENT_ID=
# CTP_CLIENT_SECRET=
# CTP_SCOPES=
# CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
# CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
# CTP_STORE_KEY=gifting
# CTP_IMPORT_URL=https://import.europe-west1.gcp.commercetools.com
# CTP_SETUP_PROJECT_KEY=
