# Copy to .env at the repo root (gitignored). Every app, service and script reads it.
# Never commit real values. See docs/technical/configuration.md.

LOG_LEVEL=info

# MongoDB. Local Docker (pnpm db:up) is the default; Atlas:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=corporate-gifting-marketplace
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=gifting

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
RECIPIENT_PUBLIC_URL=http://localhost:3001

# Every email (account and gift) goes through one SMTP provider: SendGrid on
# GCP, see docs/technical/configuration.md. Changing provider means changing
# this setting. With none set, or none answering, outside production emails are
# written to .data/outbox as .eml files with an .html preview. In production
# the API refuses to start without one.
# SMTP_URL=smtp://apikey:<SendGrid API key>@smtp.sendgrid.net:587
# The same as separate settings; when SMTP_HOST is set it is used instead of
# SMTP_URL. SMTP_PASS is secret.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# The commerce platform (docs/plans/commerce-connectors.md): commercetools, or
# memory to work locally without a platform (MEMORY_SIGN_IN=hosted plays a
# platform with its own sign-in page). Empty: register and sign-in answer 503.
# COMMERCE_CONNECTOR=commercetools
# Encrypts the API's own sessions and email links: openssl rand -hex 32.
# API_SESSION_SECRET=
# The dashboard's development workspace: "Viewing as" a member of the demo
# company (workspace routes). Never enable in a deployed environment.
DEV_AUTH=1
# commercetools sign-in (ADR 0015): an API client with only the
# manage_my_profile scope (never the admin client below).
# CTP_SIGNIN_CLIENT_ID=
# CTP_SIGNIN_CLIENT_SECRET=
# Links in account emails point here.
SENDER_PUBLIC_URL=http://localhost:3000
# The sender of every email; with a real provider it must be a verified sender.
MAIL_FROM=Gifting <no-reply@gifting.example>

# commercetools (from the week-1 spikes on). Server-only secrets.
# pnpm ct:apply and pnpm seed refuse a project key without "sandbox" or "dev"
# in it, unless CTP_SETUP_PROJECT_KEY names that exact key.
# CTP_PROJECT_KEY=gifting-sandbox
# CTP_CLIENT_ID=
# CTP_CLIENT_SECRET=
# CTP_SCOPES=
# CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
# CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
# CTP_STORE_KEY=gifting
# CTP_IMPORT_URL=https://import.europe-west1.gcp.commercetools.com
# CTP_SETUP_PROJECT_KEY=

# The commercetools connector's catalog client, read-only, apart from the
# setup client above. Scopes: view_published_products and view_products
# (with the project key, as in CTP_SCOPES); they also cover reading the
# vendor channels. Without it the connector has no catalog and the API
# serves the demo catalog from infra/seed.
# CTP_API_CLIENT_ID=
# CTP_API_CLIENT_SECRET=
# CTP_API_SCOPES=
